# --- App / Security ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOW_PUBLIC_REGISTRATION=False

# Public domain behind Cloudflare Tunnel
APP_BASE_URL=https://todo.example.com
ALLOWED_HOSTS=todo.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://todo.example.com

# Security flags (prod)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SERVE_MEDIA=True

# Optional HSTS tuning
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# --- Database ---
POSTGRES_DB=team_todo
POSTGRES_USER=team_todo
POSTGRES_PASSWORD=replace-with-strong-db-password

# --- Optional admin bootstrap on container start ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-admin-password

# --- Optional host port ---
WEB_PORT=8000

# --- Web Push (VAPID) ---
# Keys einmalig erzeugen und hier eintragen (siehe README/Deploy-Kommandos).
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_CLAIMS_SUB=mailto:admin@example.com
